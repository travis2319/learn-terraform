# ==============================
# Terraform
# ==============================

# Terraform working directory
**/.terraform/*
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform plan output
*.plan
*.out
*.tfplan

# Sensitive variable files
*.tfvars
*.tfvars.json
!**/env/*.tfvars

# Override files (local only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file
# Uncomment below if working solo; keep commented for team projects
# .terraform.lock.hcl


# ==============================
# Terragrunt
# ==============================

# Terragrunt cache
**/.terragrunt-cache/*
.terragrunt-cache/

# Terragrunt plan output
*.tgplan

# Terragrunt generated provider files
**/.terragrunt-source-manifest


# ==============================
# SSH Keys / Secrets (CRITICAL)
# ==============================

*.pem
*.key
*.ppk

# Generic key patterns
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Project-specific keys (matches your structure)
terraform-ec2-key
terraform-ec2-key.pub
terraform-key-dev
terraform-key-dev.pub
terraform-key-prod
terraform-key-prod.pub
terraform-key-staging
terraform-key-staging.pub

# Catch-all for any keys directory
**/keys/*


# ==============================
# Logs
# ==============================

*.log
logs/
*.log.*


# ==============================
# OS / Editor
# ==============================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/

# JetBrains
.idea/

# Vim
*.swp
*.swo
*~