# ==============================
# Terraform
# ==============================

# Terraform working directory
**/.terraform/*
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform plan output
*.plan
*.out

# Sensitive variable files
*.tfvars
*.tfvars.json
terraform.tfvars
terraform.tfvars.json

# Override files (local only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file
# Commit this in team projects for version consistency.
# Ignore only if working solo.
.terraform.lock.hcl


# ==============================
# SSH / Keys (VERY IMPORTANT)
# ==============================

*.pem
*.key
id_rsa
id_rsa.pub
terraform-ec2-key
terraform-ec2-key.pub


# ==============================
# Logs
# ==============================

*.log


# ==============================
# OS / Editor
# ==============================

.DS_Store
Thumbs.db

# VS Code
.vscode/

# JetBrains
.idea/

# Vim
*.swp