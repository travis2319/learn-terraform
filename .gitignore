# ---- Terraform ----
# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Sensitive variable files
*.tfvars
*.tfvars.json

# Override files (used for local testing only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.plan

# Terraform lock file (can be checked in for team consistency, but ignoring if local only)
.terraform.lock.hcl

# ---- SSH Keys ----
terraform-ec2-key
terraform-ec2-key.pub
*.pem
*.key

# ---- Misc ----
# Editor / OS specific
.DS_Store
Thumbs.db
.idea/
.vscode/
